{
  "name": "paperclip-arabic-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Paperclip Arabic Desktop contributors",
  "repository": "https://github.com/paperclipai/paperclip",
  "description": "Windows desktop shell for the Arabic-first Paperclip control plane",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "6.7.3"
  },
  "devDependencies": {
    "electron": "39.2.7",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.paperclip.arabicdesktop",
    "productName": "Paperclip Arabic",
    "directories": { "output": "../dist-windows" },
    "files": ["main.cjs", "update-watch.cjs", "auto-update.cjs", "assets/**/*", "package.json", "node_modules/**/*"],
    "extraResources": [
      { "from": "../runtime/node.exe", "to": "runtime/node.exe" },
      { "from": "../runtime/node_modules", "to": "runtime/node_modules", "filter": ["**/*", "!**/*.map"] }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "assets/app.ico",
      "signAndEditExecutable": false,
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Paperclip-Arabic-Setup-${version}.${ext}"
    },
    "publish": [{ "provider": "github", "owner": "amen78977", "repo": "paperclip", "releaseType": "release" }],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
